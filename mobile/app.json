{
  "expo": {
    "name": "Nexzoneo",
    "slug": "nexzoneo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#141B4D"
    },
    "scheme": "nexzoneo",
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/icon.png"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nexzoneo.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Nexzoneo uses your location to show nearby products and sellers.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Nexzoneo uses your location to show nearby products and sellers."
      }
    },
    "android": {
      "package": "com.nexzoneo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#141B4D"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#141B4D"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Nexzoneo to use your location to find nearby products."
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "replace-after-eas-init"
      }
    }
  }
}
